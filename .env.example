# Copiar a .env y completar. .env NUNCA se sube al repo.

# --- Bifrost (P2) ---
# URL del gateway local (docker compose up)
BIFROST_URL=http://localhost:8080
# Modelos en formato proveedor/modelo, tal como los expone Bifrost
FRESHCODE_MODEL_PLANNER=proveedor/modelo-barato
FRESHCODE_MODEL_EDITOR=proveedor/modelo-fuerte
FRESHCODE_MODEL_JUDGE=proveedor/modelo-barato

# --- Tavily (P3) ---
TAVILY_API_KEY=

# Las claves de los proveedores de LLM se configuran dentro de Bifrost
